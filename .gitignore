# CC Connect Optimized - .gitignore

# Ignore user configuration files
config.toml
*.local.toml

# Ignore session data
sessions/
crons/
run/

# Ignore log files
*.log

# Ignore temporary files
*.tmp
*.temp

# Ignore IDE settings
.vscode/
.idea/

# Ignore OS files
.DS_Store
Thumbs.db

# Ignore node_modules
node_modules/

# Ignore sensitive data
.env
.env.local
.env.*.local

# Ignore original project files (keep for reference)
cc-connect-main/
cc-connect-main.zip
